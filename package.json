{
  "name": "jmc-ai-analyzer-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "api:types": "npx -y openapi-typescript@7.13.0 ${API_URL:-http://localhost:8080}/v3/api-docs -o src/app/core/api/generated/api.d.ts",
    "api:check": "node scripts/api-check.mjs",
    "e2e": "playwright test",
    "e2e:up": "bash scripts/e2e-up.sh",
    "verify": "npm run lint && npm run test:ci && npm run build"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/user-event": "^14.6.12",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.0"
  }
}
